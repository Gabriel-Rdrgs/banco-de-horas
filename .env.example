# ==============================================================
# Banco de Horas OCR — Provida Centro Médico
# Template de variáveis de ambiente
#
# Como usar:
#   1. Copie este arquivo: .env.example → .env
#   2. Preencha os valores reais em .env
#   3. NUNCA versione o .env (já está no .gitignore)
# ==============================================================

# --- Azure Computer Vision (OCR principal) ---
# Obtido em: portal.azure.com → recurso provida-vision → Chaves e Ponto de Extremidade
AZURE_VISION_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/
AZURE_VISION_KEY=sua-chave-azure-aqui

# --- Google Cloud Vision (alternativa — requer billing ativo) ---
# Deixe em branco se não for usar
# GOOGLE_APPLICATION_CREDENTIALS=gcp_key.json

# --- Anthropic Claude Vision (alternativa — requer créditos API) ---
# Deixe em branco se não for usar
# ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Configurações do pipeline ---
OCR_ENGINE=azure_vision
OCR_CONFIANCA_MINIMA=70.0
OCR_USUARIO_PADRAO=SISTEMA
